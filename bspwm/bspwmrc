#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &
polybar &
# Disable DPMS (Display Power Management Signaling)
xset -dpms

# Turn off screen saver blanking
xset s off
xset s noblank

#xrandr --query | grep " connected" | cut -d" " -f1 | xargs -I {} vibrant-cli {} 2.0
#xrandr --query | grep " connected" | cut -d' ' -f1 | xargs -I {} xrandr --output {} --gamma 0.8:0.8:0.8 --brightness 0.9

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width         1
bspc config window_gap          1

bspc config split_ratio          0.50
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc rule -a konsole state=floating
bspc config focused_border_color "#000000"
bspc config normal_border_color "#000000"
bspc config top_padding 0

# picom &
sudo rm -rf /etc/xdg/autostart
